# Copy to backend/.env and fill in. Never commit the real .env.
# --- AI editor -------------------------------------------------------------
# Free: create a key at https://console.groq.com/keys (no card needed). It powers the chat editor
# (open model on Groq) and fast cloud transcription for captions (Whisper on Groq).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b      # or openai/gpt-oss-20b (faster, weaker)
# GROQ_REASONING=low                  # low | medium | high
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# CLOUD_TRANSCRIPTION=1               # 0 = always transcribe locally with faster-whisper
# AI_PROVIDER=groq                    # groq | anthropic (default: groq if GROQ_API_KEY is set)

# Optional paid alternative: Claude via the Anthropic API (set AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
# CLAUDE_FALLBACKS=default      # set to "off" to disable server-side refusal fallbacks
# AGENT_MAX_ROUNDS=25
# WHISPER_MODEL=small           # tiny | base | small | medium | large-v3
# WHISPER_DEVICE=auto           # auto | cpu | cuda
# VIDEO_EDITOR_DATA_DIR=./data
# MAX_UPLOAD_MB=4096
# OVERLAY_FONT=/path/to/font.ttf
# CORS_ORIGINS=http://localhost:3000
# Hosting: require a password for the whole app (leave empty for local use)
# APP_PASSWORD=
# APP_SECRET=any-long-random-string
# FRONTEND_DIR=../frontend/out
