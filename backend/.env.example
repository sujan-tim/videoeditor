# Copy to backend/.env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
# CLAUDE_FALLBACKS=default      # set to "off" to disable server-side refusal fallbacks
# AGENT_MAX_ROUNDS=25
# WHISPER_MODEL=small           # tiny | base | small | medium | large-v3
# WHISPER_DEVICE=auto           # auto | cpu | cuda
# VIDEO_EDITOR_DATA_DIR=./data
# MAX_UPLOAD_MB=4096
# OVERLAY_FONT=/path/to/font.ttf
# CORS_ORIGINS=http://localhost:3000
